# ==============================================================================
# ShopSmart AI — Environment Configuration Template
# Copy this file to `.env` in the root or in `backend/.env`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Required for Generative AI features)
# Generate key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
EMBED_DIM=768
USE_FAKE_LLM=false

# ------------------------------------------------------------------------------
# 2. Clerk Authentication (Required for production sign-in & JWT verification)
# Generate keys at: https://dashboard.clerk.com/ -> select app -> API Keys
# Note: When CLERK_MOCK_AUTH=true, you can test locally using X-Mock-User-Id header
# ------------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_MOCK_AUTH=true

# ------------------------------------------------------------------------------
# 3. Database Configuration (Prisma ORM & PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopsmart_db

# ------------------------------------------------------------------------------
# 4. Inngest Background Workflows (Optional for local dev, required for cloud)
# Dashboard: https://app.inngest.com/
# For local dev without cloud keys, Inngest runs in dev mode automatically.
# ------------------------------------------------------------------------------
INNGEST_APP_ID=shopsmart-backend
INNGEST_IS_DEV=true
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ------------------------------------------------------------------------------
# 5. Server & Security Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
PORT=8000
HOST=0.0.0.0
