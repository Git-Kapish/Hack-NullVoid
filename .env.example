# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/shopsmart_db
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/shopsmart_test_db

# Security & Authentication
JWT_SECRET=shopsmart-hackathon-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_ISSUER=shopsmart-api
JWT_AUDIENCE=shopsmart-web
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBED_DIM=768
USE_FAKE_LLM=true

# Server & CORS
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
PORT=8000
HOST=0.0.0.0
